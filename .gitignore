__pycache__/
*.py[cod]
*.pyo
*.pyd
*.log
.env
.venv/
venv/
.pytest_cache/
.mypy_cache/
.idea/
.DS_Store

# A checkout whose .env still says LOG_DIRECTORY=logs. `*.log` above does not
# cover the rotated backups, which end in `.log.1` (RFC-034 section 2.6).
/logs/

# Runtime data materialized by the indexing worker / dataset_tools (RFC-022 9.1)
data/

# Frontend build artifacts (Electron)
frontend/node_modules/
frontend/release/
frontend/resources/
# The interface the API serves, and the window's main process (RFC-037 4.1)
frontend/dist/
frontend/dist-electron/

# The embedded PostgreSQL runtime, materialized from scripts/postgres-win-64.lock
# by scripts/vendor_postgres.py (RFC-033 section 5.1)
/runtime/
