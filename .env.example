# Example environment configuration for SolidVision
PROJECT_NAME=SolidVision
PROJECT_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=solidvision
DATABASE_USER=solidvision
DATABASE_PASSWORD=solidvision

EMBEDDING_MODEL=google/siglip-base-patch16-224
EMBEDDING_DIMENSION=1152
DEVICE=cpu

DEFAULT_COLLECTION_NAME=default
BATCH_SIZE=16
WORKER_COUNT=1
SUPPORTED_EXTENSIONS=.jpg,.jpeg,.png,.tiff,.bmp,.webp

TOP_K_RESULTS=10
MINIMUM_SIMILARITY=0.0

LOG_LEVEL=INFO
LOG_DIRECTORY=logs
LOG_FILENAME=application.log
