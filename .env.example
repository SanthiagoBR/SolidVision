# Example environment configuration for SolidVision
#
# A checkout reads this file's copy, `.env`, at the repository root, below the
# process environment. An installed app reads neither: it reads
# %LOCALAPPDATA%\SolidVision\solidvision.env, which has these same keys, and
# ignores the process environment (RFC-034 section 5). The mode is not a key:
# it is `development` when pyproject.toml is beside the code.
#
# A key that is not a setting is ignored, and named in the log.
# Write paths without quotes, spaces included: double quotes turn the \f, \n,
# \r and \t of a Windows path into control characters. A relative path is
# relative to the folder of the file it is written in.
PROJECT_NAME=SolidVision
PROJECT_VERSION=0.1.0
DEBUG=false

# Where the database connection comes from. `external` is DATABASE_* below:
# this file and the Docker container. `embedded` is the cluster of RFC-033,
# started with `python -m app.infrastructure.database.embedded start`; its
# port and password are read from the cluster at every new connection, and
# DATABASE_* is not read at all. An installed app is always `embedded`.
# DATABASE_SOURCE=external
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=solidvision
DATABASE_USER=solidvision
DATABASE_PASSWORD=solidvision

EMBEDDING_MODEL=laion/CLIP-ViT-B-32-laion2B-s34B-b79K
EMBEDDING_DIMENSION=512
# auto -> CUDA when torch reports it available, CPU otherwise
DEVICE=auto

DEFAULT_COLLECTION_NAME=default
# Images per model forward pass during indexing. Bounded by memory:
# raising it holds proportionally more decoded pixels at once.
BATCH_SIZE=8
# Discovered files whose stored index metadata is read back per query.
# Independent of BATCH_SIZE -- this one reads scalars, not pixels.
METADATA_PREFETCH_SIZE=512
WORKER_COUNT=1
SUPPORTED_EXTENSIONS=.jpg,.jpeg,.png,.tiff,.bmp,.webp

# Default number of search results per query, when the caller does not
# ask for a specific number. MINIMUM_SIMILARITY was removed by RFC-025:
# nothing read it, and its 0..1 bound contradicted the [-1, 1] range of
# the cosine scores search returns.
TOP_K_RESULTS=10

# RFC-032. Read each photo's EXIF GPS position during the scan, in the same
# open of the file as the capture date. Off means "not examined", never "no
# position": those rows are picked up by the next scan with it on, or by
# python -m app.infrastructure.workers.exif_backfill --root PATH.
EXTRACT_GPS=true
# Smallest radius, in metres, a "near here" search accepts. Photo positions
# are where the drone was, not the ground it photographed; 300 is the 95th
# percentile of that offset measured on real DJI files, rounded up to 50 m
# (experiments/rfc-032-geolocation/measure_gps_cost.log).
MIN_RADIUS_M=300
# Most cells GET /api/v1/images/map returns before coarsening its grid. 2000
# keeps the worst-case answer near 107 KB (54.8 bytes per cell, measured).
MAX_MAP_CELLS=2000

# Load the CLIP checkpoint when the API starts instead of on the first
# search. Off by default so that importing the app -- which a test run, a
# CI job, or a REPL does -- never downloads a checkpoint; turn it on when
# running the API for real, or the first query of every process pays the
# ~5 s model load (RFC-026 section 10).
WARM_UP_MODELS=true

# Let POST /api/v1/images/{id}/reveal open Explorer on this machine with the
# photo selected. Off by default, like WARM_UP_MODELS: the safe default is the
# one that cannot act on a machine that never asked -- with it off the route
# answers 404, as if it did not exist. Even when on, only callers on loopback
# (127.0.0.1, ::1) are served; a request from the network is refused however
# this is set (RFC-030 section 6). Paths in search results do not depend on it.
ALLOW_LOCAL_FILE_ACTIONS=false

# Where thumbnails are kept. Never inside a photo collection: the system does
# not write to the collection, and thumbnails kept beside the photos would be
# unavailable exactly when their disk is unplugged (RFC-030 section 7.1).
# Indexing skips this directory even if it lies under a scanned folder.
# Unset, it defaults to `thumbnails` under the data directory:
# %LOCALAPPDATA%\SolidVision-dev in a checkout, %LOCALAPPDATA%\SolidVision
# installed.
# THUMBNAIL_DIRECTORY=
# Longest side of a generated thumbnail, in pixels. Changing it does not
# re-render existing thumbnails: run
# `python -m app.infrastructure.workers.thumbnail_backfill --root PATH --force`.
THUMBNAIL_MAX_EDGE=512

# RFC-033, the embedded PostgreSQL cluster. Both are read by
# `python -m app.infrastructure.database.embedded`, which starts the cluster,
# and by the engine when DATABASE_SOURCE is `embedded`.
# Where the vendored binaries are. Never taken from PATH. Unset, it defaults
# to runtime/postgres under the repository, where
# `python scripts/vendor_postgres.py` puts them.
# EMBEDDED_POSTGRES_RUNTIME_DIRECTORY=
# Where the cluster, its password and its logs live, per user. Unset, it
# defaults to `postgres` under the data directory, so a checkout's cluster
# and an installed app's are already apart.
# EMBEDDED_POSTGRES_DIRECTORY=

LOG_LEVEL=INFO
# Unset, the log goes to `logs` under the data directory, one file per
# program: uvicorn.log, job_runner.log, pytest.log (RFC-034 section 8).
# LOG_DIRECTORY=
# One fixed name for every process, as before RFC-034. Two processes writing
# to one file do not rotate it while both live.
# LOG_FILENAME=
